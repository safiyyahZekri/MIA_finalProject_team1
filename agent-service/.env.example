# --- LLM ---
# "mock"      needs no key/model and runs fully offline (regex heuristics).
# "ollama"    real local LLM via `ollama serve` -- e.g. qwen2.5. No API key,
#             no cloud cost, but only works on the machine Ollama is
#             installed on -- fine for solo dev, NOT for a shared team demo.
# "groq"      hosted LLM via a shared Groq API key. Fast, doesn't depend on
#             anyone's specific machine being on -- recommended for the
#             team demo/grading, once you have a key.
# "anthropic" uses a real, resource-efficient Claude model via API key.
LLM_PROVIDER=ollama

# --- Groq (only used when LLM_PROVIDER=groq) ---
# 1. Get a key from https://console.groq.com
# 2. Paste it below
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_S=30

# --- Ollama (only used when LLM_PROVIDER=ollama) ---
# 1. Install Ollama: https://ollama.com
# 2. Pull the model once:  ollama pull qwen2.5:7b
# 3. Make sure the server is running:  ollama serve   (usually auto-started)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_S=60
OLLAMA_FALLBACK_TO_MOCK=true

ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# --- retrieval-api (teammate's service, confirmed live on port 8002) ---
# If running standalone (uvicorn, no Docker): http://localhost:8002
# If running via `docker compose up`: http://retrieval-api:8002 (service name)
RETRIEVAL_API_URL=http://localhost:8002
RETRIEVAL_TIMEOUT_S=10
# Was true during solo dev so agent-service kept working before retrieval-api
# existed. Now that it's live and confirmed, this must be false -- otherwise
# a real retrieval failure gets silently masked with fabricated mock
# evidence instead of surfacing as an error, which is exactly the kind of
# "faithful, never-hallucinate" failure this project is graded against.
RETRIEVAL_FALLBACK_TO_MOCK=false

# --- answer-validator-api (teammate's service) ---
# Leave empty in normal operation -- the orchestrator calls the validator.
# Set this only if you want agent-service to also call it directly while
# testing in isolation.
ANSWER_VALIDATOR_URL=

# --- retrieval / retry tuning ---
TOP_K_OVERRETRIEVE=30
TOP_K_FINAL=5
MAX_RETRIES=2
MIN_EVIDENCE_SCORE=0.35

# --- service ---
HOST=0.0.0.0
PORT=8003
