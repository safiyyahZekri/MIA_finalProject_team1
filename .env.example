# Copy to .env (same folder as docker-compose.yml) and fill in your own keys.
# .env is git-ignored; never commit real keys.

# --- Language model ---------------------------------------------------------
# gemini: the configuration all reported results use.
# mock:   no key, canned heuristic answers (for checking the stack only).
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# One or more Google AI Studio keys, comma-separated. When one uses its daily
# quota the next is tried. Keys from the same Google project share one quota.
GEMINI_API_KEYS=
# A single key also works:
GEMINI_API_KEY=

# Optional: Claude instead of Gemini (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Tracing (optional) -----------------------------------------------------
# Without these keys everything runs, but nothing is sent to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Retrieval index format (only for building a new index) -----------------
# An existing index keeps the format recorded in its manifest. Set this before
# building an index from PDFs to give it company metadata from the start.
# LEDGER_INDEX_FORMAT=contextual_text,company_metadata
